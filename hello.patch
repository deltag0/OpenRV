+        prior = env.get("PYTHONPATH", "")
+        env["PYTHONPATH"] = os.pathsep.join(pkg_dirs + ([prior] if prior else []))
     # Root/container safety (harmless otherwise).
     env.setdefault("QTWEBENGINE_DISABLE_SANDBOX", "1")
 
