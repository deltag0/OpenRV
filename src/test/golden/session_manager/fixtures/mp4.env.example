# Local MP4 integration test paths (copy to mp4.env and edit).
# mp4.env is gitignored — do not commit machine-specific paths.
#
# Required: directory containing *.mp4 clips for sm_mp4_all.py
SM_TEST_MP4_DIR=/path/to/your/mp4/clips

# Optional: single clip for sm_mp4_load.py (defaults to first *.mp4 in SM_TEST_MP4_DIR)
# SM_TEST_MP4_FIXTURE=/path/to/one/clip.mp4

# Optional: still-image / tiny movie for sm_media_* scenarios (repo fixtures if unset)
# SM_TEST_IMAGE_FIXTURE=/path/to/frame.jpg
# SM_TEST_MOVIE_FIXTURE=/path/to/clip.mp4

# Optional: wait for rvio thumbnail+filmstrip on every clip in sm_mp4_all (very slow)
# SM_TEST_MP4_QUIESCE=1
